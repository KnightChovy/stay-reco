@startuml
' State machine of room_calendars (one room, one night) (Report 4, Figure 22). States show the label of the figure and the value stored in the code.
' A night on sale has no row; holding, booking or blocking creates one and releasing the night deletes it.
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
hide empty description
state "Night on sale\n(no row)" as ONSALE
state "Night held\n(15-minute hold)\n(HELD)" as HELD
state "Night booked\n(BOOKED)" as BOOKED
state "Night blocked\n(BLOCKED)" as BLOCKED
[*] --> ONSALE
ONSALE --> HELD : [Customer books]
HELD --> ONSALE : [Hold expired]
HELD --> BOOKED : [Payment confirmed]
ONSALE --> BLOCKED : [Partner closes the night]
BLOCKED --> ONSALE : [Partner reopens the night]
BOOKED --> ONSALE : [Booking cancelled,\nrefund approved,\nno-show or\nearly check-out]
BOOKED --> [*] : [The night has passed]
@enduml
