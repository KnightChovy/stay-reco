@startuml
' Frontend Package Diagram (Report 4, Figure 3). Generated from the imports of the code: an arrow means
' "the tail package imports the head package".
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #333333
skinparam packageStyle folder
skinparam package {
  BorderColor #333333
  BackgroundColor #FFFFFF
}
title Frontend Package Diagram
package "@stayreco/shared" as _stayreco_shared {
}
package "app" as app {
}
package "components" as components {
}
package "features" as features {
}
package "hooks" as hooks {
}
package "lib" as lib {
}
package "provider" as provider {
}
package "services" as services {
}
package "stores" as stores {
}
package "types" as types {
}
app ..> _stayreco_shared
app ..> components
app ..> features
app ..> hooks
app ..> lib
app ..> provider
app ..> services
components ..> features
components ..> hooks
components ..> lib
features ..> _stayreco_shared
features ..> components
features ..> hooks
features ..> lib
features ..> services
lib ..> _stayreco_shared
lib ..> stores
lib ..> types
services ..> _stayreco_shared
services ..> lib
services ..> types
stores ..> _stayreco_shared
stores ..> services
types ..> _stayreco_shared
legend bottom right
  - - -> : <<import>> (tail package imports head package)
endlegend
@enduml
