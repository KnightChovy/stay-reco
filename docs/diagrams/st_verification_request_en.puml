@startuml
' State machine of hotel_verification_request.status (Report 4, Figure 20). States show the label of the figure and the value stored in the code.
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam ArrowColor #333333
hide empty description
state "Waiting for review\n(PENDING)" as PENDING
state "Request approved\n(APPROVED)" as APPROVED
state "Request rejected\n(REJECTED)" as REJECTED
state "Revision needed\n(NEEDS_REVISION)" as NEEDS_REVISION
state origin <<choice>>
state decision <<choice>>
[*] --> origin
origin --> PENDING : [Partner submits\nINITIAL or UPDATE]
origin --> NEEDS_REVISION : [Manager asks an active hotel\nto verify again (RENEWAL)]
PENDING --> decision
decision --> APPROVED : [Manager approves]
decision --> REJECTED : [Manager rejects\nwith a reason]
decision --> NEEDS_REVISION : [Manager asks for changes]
APPROVED --> [*]
REJECTED --> [*]
NEEDS_REVISION --> [*]
@enduml
