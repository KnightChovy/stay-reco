<mxfile host="app.diagrams.net"><diagram id="WF-03" name="WF-03"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1391" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-C" value="Customer" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="210" height="1391" as="geometry"/></mxCell><mxCell id="lane-St" value="Hotel Staff (front desk)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="210" y="0" width="250" height="1391" as="geometry"/></mxCell><mxCell id="lane-S" value="StayReco System" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="0" width="360" height="1391" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="93" y="48" width="24" height="24" as="geometry"/></mxCell><mxCell id="arrive" value="Guest comes during&lt;br&gt;the stay dates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="104.5" width="150" height="60" as="geometry"/></mxCell><mxCell id="noShow" value="Mark NO_SHOW: staff from the day after&lt;br&gt;check-in, or the job at the check-out time&lt;br&gt;&lt;b&gt;Booking [CONFIRMED → NO_SHOW]&lt;/b&gt;&lt;br&gt;Release the nights from today; hotel&lt;br&gt;keeps the payment, commission charged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="92.5" width="250" height="84" as="geometry"/></mxCell><mxCell id="end0" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="779" y="123.5" width="22" height="22" as="geometry"/></mxCell><mxCell id="show" value="Show the QR voucher or&lt;br&gt;give the booking code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="217" width="170" height="44" as="geometry"/></mxCell><mxCell id="scan" value="Scan the QR voucher or&lt;br&gt;type the booking code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="217" width="180" height="44" as="geometry"/></mxCell><mxCell id="found" value="Booking of this&lt;br&gt;hotel found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="565" y="273.5" width="150" height="60" as="geometry"/></mxCell><mxCell id="notFound" value="Show VOUCHER_INVALID /&lt;br&gt;BOOKING_NOT_FOUND" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="281.5" width="170" height="44" as="geometry"/></mxCell><mxCell id="end1" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="219" y="292.5" width="22" height="22" as="geometry"/></mxCell><mxCell id="openQ" value="CONFIRMED and PAID,&lt;br&gt;no refund waiting, today&lt;br&gt;in the stay dates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="386" width="190" height="76" as="geometry"/></mxCell><mxCell id="refuse" value="Refuse check-in:&lt;br&gt;CHECK_IN_NOT_OPEN,&lt;br&gt;REFUND_DECISION_PENDING,&lt;br&gt;BOOKING_STATUS_CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="281" y="392" width="172" height="64" as="geometry"/></mxCell><mxCell id="end2" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="219" y="413" width="22" height="22" as="geometry"/></mxCell><mxCell id="options" value="List the held rooms and the other&lt;br&gt;AVAILABLE rooms of the room type" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="514.5" width="230" height="44" as="geometry"/></mxCell><mxCell id="choose" value="Keep the held rooms&lt;br&gt;or choose other rooms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="587" width="170" height="44" as="geometry"/></mxCell><mxCell id="free" value="Rooms still free&lt;br&gt;and AVAILABLE?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="565" y="579" width="150" height="60" as="geometry"/></mxCell><mxCell id="checkIn" value="Move the remaining nights to the rooms&lt;br&gt;&lt;b&gt;Booking [CONFIRMED → CHECKED_IN]&lt;/b&gt;&lt;br&gt;&lt;b&gt;Room [AVAILABLE → OCCUPIED]&lt;/b&gt;&lt;br&gt;Close a waiting change request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="493" y="682" width="270" height="70" as="geometry"/></mxCell><mxCell id="stay" value="Stay at the hotel" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="699" width="150" height="36" as="geometry"/></mxCell><mxCell id="leave" value="Come to the desk to leave&lt;br&gt;(early, on time or late)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fo