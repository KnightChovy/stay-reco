<mxfile host="app.diagrams.net"><diagram id="WF-04" name="WF-04"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="2013" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane-C" value="Customer" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="230" height="2013" as="geometry"/></mxCell><mxCell id="lane-S" value="System (Backend)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="0" width="420" height="2013" as="geometry"/></mxCell><mxCell id="lane-St" value="Hotel Staff" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="650" y="0" width="230" height="2013" as="geometry"/></mxCell><mxCell id="lane-O" value="Hotel Owner (Partner)" style="swimlane;startSize=30;html=1;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="880" y="0" width="240" height="2013" as="geometry"/></mxCell><mxCell id="region" value="Interruptible activity region" style="rounded=1;arcSize=4;dashed=1;strokeWidth=1.5;fillColor=none;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="657" y="969.6" width="456" height="428.2" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="103" y="48" width="24" height="24" as="geometry"/></mxCell><mxCell id="mStart" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="103" y="104.5" width="24" height="24" as="geometry"/></mxCell><mxCell id="A1" value="A" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="39" y="105.5" width="22" height="22" as="geometry"/></mxCell><mxCell id="open" value="Open booking details,&lt;br&gt;choose “Cancel booking”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="27.5" y="161" width="175" height="44" as="geometry"/></mxCell><mxCell id="error" value="Show error (already checked&lt;br&gt;in / refund already pending /&lt;br&gt;booking no longer active)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="299" width="180" height="56" as="geometry"/></mxCell><mxCell id="endErr" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="102" y="387.5" width="26" height="26" as="geometry"/></mxCell><mxCell id="review" value="Review the cancellation&lt;br&gt;fee and refund amount" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="170" height="44" as="geometry"/></mxCell><mxCell id="reason" value="Enter cancellation reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="551.5" width="170" height="36" as="geometry"/></mxCell><mxCell id="confirm" value="Confirm&lt;br&gt;cancellation?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="130" height="52" as="geometry"/></mxCell><mxCell id="endKeep" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="102" y="724.5" width="26" height="26" as="geometry"/></mxCell><mxCell id="rejEmail" value="Receive the rejection email&lt;br&gt;(reason shown on the booking)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="27" y="1339.3" width="176" height="44" as="geometry"/></mxCell><mxCell id="choice" value="Customer’s&lt;br&gt;choice?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="1415.8" width="110" height="48" as="geometry"/></mxCell><mxCell id="A2" value="A" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="104" y="1516.3" width="22" height="22" as="geometry"/></mxCell><mxCell id="endKeep2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="187" y="1514.3" width="26" height="26" as="geometry"/></mxCell><mxCell id="N" value="N" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="103" y="1667.3" width="24" height="24" as="geometry"/></mxCell><mxCell id="result" value="Receive the result email&lt;br&gt;(cancelled / refund credited&lt;br&gt;to the StayReco wallet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="27.5" y="1741" width="175" height="56" as="geometry"/></mxCell><mxCell id="ffCust" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="104" y="1829.5" width="22" height="22" as="geometry"/></mxCell><mxCell id="quote" value="Get cancellation quote&lt;br&gt;&lt;i&gt;GET /bookings/:id/cancellation-quote&lt;/i&gt;&lt;br&gt;Check: booking CONFIRMED, invoice PAID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="215.5" width="250" height="56" as="geometry"/></mxCell><mxCell id="cancellable" value="Cancellable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="304" width="120" height="46" as="geometry"/></mxCell><mxCell id="mErr" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="243" y="315" width="24" height="24" as="geometry"/></mxCell><mxCell id="calc" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Calculate fee and refund&lt;/b&gt;&lt;br&gt;• Before the free-cancel deadline: fee = 0&lt;br&gt;• After it: fee = fee % × amount paid&lt;br&gt;• Fee rounded half up to 2 decimals&lt;br&gt;• Refund = amount paid − fee&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="317.5" y="402.5" width="245" height="80" as="geometry"/></mxCell><mxCell id="submit" value="Submit cancellation&lt;br&gt;&lt;i&gt;POST /bookings/:id/cancel&lt;/i&gt;&lt;br&gt;Re-check and recalculate&lt;br&gt;amounts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="447" y="616" width="186" height="60" as="geometry"/></mxCell><mxCell id="still" value="Still&lt;br&gt;cancellable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="715.8" width="120" height="50" as="geometry"/></mxCell><mxCell id="amount" value="Refund&lt;br&gt;amount?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="818.3" width="100" height="50" as="geometry"/></mxCell><mxCell id="cancelled" value="Booking → CANCELLED&lt;br&gt;Release the nights&lt;br&gt;for sale; hotel keeps&lt;br&gt;the full amount as fee&lt;br&gt;Record history, email" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="802.3" width="150" height="82" as="geometry"/></mxCell><mxCell id="fork1" value="" style="html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="916.8" width="110" height="6" as="geometry"/></mxCell><mxCell id="B1" value="B" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="339" y="955.3" width="22" height="22" as="geometry"/></mxCell><mxCell id="pending" value="Invoice → REFUND_PENDING&lt;br&gt;Booking stays CONFIRMED,&lt;br&gt;rooms held; record history&lt;br&gt;Email the customer and the&lt;br&gt;hotel (owner, REFUND staff)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="447" y="920.8" width="186" height="76" as="geometry"/></mxCell><mxCell id="who" value="Who handles&lt;br&gt;it?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="1029.3" width="100" height="48" as="geometry"/></mxCell><mxCell id="mAuto" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="498" y="1251.8" width="24" height="24" as="geometry"/></mxCell><mxCell id="rejectSys" value="Reject refund&lt;br&gt;&lt;i&gt;POST /bookings/:id/reject-refund&lt;/i&gt;&lt;br&gt;Invoice → PAID, booking stays&lt;br&gt;CONFIRMED; email the reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="1329.3" width="200" height="64" as="geometry"/></mxCell><mxCell id="refund" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Refund (manual or automatic approval)&lt;/b&gt;&lt;br&gt;&lt;i&gt;POST /bookings/:id/approve-refund / every-minute job&lt;/i&gt;&lt;br&gt;• Booking → CANCELLED, release the nights&lt;br&gt;• Hotel wallet (pending): − refund&lt;br&gt;• Customer wallet (available): + refund&lt;br&gt;• Invoice → REFUNDED / PARTIALLY_REFUNDED&lt;br&gt;• Record history, email customer&lt;br&gt;• Auto-approval: owner is emailed too&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="1469.3" width="280" height="116" as="geometry"/></mxCell><mxCell id="fork2" value="" style="html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="405" y="1617.8" width="150" height="6" as="geometry"/></mxCell><mxCell id="feeKept" value="Fee kept?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="425" y="1656.3" width="110" height="46" as="geometry"/></mxCell><mxCell id="ffNoFee" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="604" y="1668.3" width="22" height="22" as="geometry"/></mxCell><mxCell id="B2" value="B" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="389" y="1755.8" width="22" height="22" as="geometry"/></mxCell><mxCell id="M" value="M" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="1754.8" width="24" height="24" as="geometry"/></mxCell><mxCell id="hold" value="1 day after the cancellation&lt;br&gt;(WALLET_HOLD_DAYS)" style="shape=collate;html=1;fillColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;labelPosition=left;align=right;spacingLeft=0;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="468" y="1811.3" width="24" height="34" as="geometry"/></mxCell><mxCell id="settle" value="Settle the kept fee: hotel wallet&lt;br&gt;pending → available (SETTLEMENT),&lt;br&gt;no commission; &lt;i&gt;hourly job&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="1877.8" width="230" height="56" as="geometry"/></mxCell><mxCell id="ffSettle" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="469" y="1966.3" width="22" height="22" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The free-cancellation deadline and fee % are fixed on the booking when it is made (BR-07)&lt;br&gt;• The fee and refund are fixed when the customer cancels; the hotel approves exactly that amount&lt;br&gt;• No cancellation after check-in (BR-09)&lt;br&gt;• Every step re-checks the status in a transaction: concurrent actions apply only once" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="665" y="167.2" width="200" height="190" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;Check-in while pending&lt;/b&gt;&lt;br&gt;While a refund is pending, check-in is refused (REFUND_DECISION_PENDING): the owner decides first. A cancel and a check-in at the same moment: only one succeeds." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="665" y="528" width="200" height="116" as="geometry"/></mxCell><mxCell id="note3" value="&lt;b&gt;Automatic approval&lt;/b&gt;&lt;br&gt;A job runs every minute. A request still pending at the hotel’s check-in time on the check-in date, and made BEFORE that time, is approved automatically, even if staff already forwarded it.&lt;br&gt;Requests made after the check-in time: only the owner decides.&lt;br&gt;Suspended hotel: can still approve, cannot reject." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=5;spacingTop=2;fontSize=10;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="895" y="241.3" width="210" height="200" as="geometry"/></mxCell><mxCell id="forward" value="Review the request, forward it&lt;br&gt;to the owner with a note&lt;br&gt;&lt;i&gt;POST /bookings/:id/forward-refund&lt;/i&gt;&lt;br&gt;(REFUND permission, emails owner)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="1021.3" width="190" height="64" as="geometry"/></mxCell><mxCell id="timeCheckIn" value="Check-in time&lt;br&gt;reached" style="shape=collate;html=1;fillColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="783" y="1170.3" width="24" height="34" as="geometry"/></mxCell><mxCell id="bolt" value="↯" style="text;html=1;fontSize=24;align=center;verticalAlign=middle;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="647" y="1174.3" width="20" height="26" as="geometry"/></mxCell><mxCell id="mOwner" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="988" y="1109.8" width="24" height="24" as="geometry"/></mxCell><mxCell id="reviewReq" value="Review the refund request&lt;br&gt;(Refunds tab)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="1166.3" width="180" height="42" as="geometry"/></mxCell><mxCell id="decision" value="Decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" vertex="1" parent="1"><mxGeometry x="945" y="1240.8" width="110" height="46" as="geometry"/></mxCell><mxCell id="chooseReason" value="Choose a rejection&lt;br&gt;reason (BR-20)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=22;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="915" y="1339.3" width="170" height="44" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="mStart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="A1" target="mStart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mStart" target="open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="quote"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="183"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fon