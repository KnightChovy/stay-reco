NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://stayreco:stayreco@localhost:5432/stayreco?schema=public

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3001
# Used to build links in emails (reset password, invitations)
WEB_APP_URL=http://localhost:3001

# Email (SMTP via Nodemailer). Leave SMTP_HOST empty to print emails to the console (dev, tests).
# Gmail (demo): 2-Step Verification on, then create an App Password; MAIL_FROM must be the same Gmail address.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
# Mailtrap sandbox (dev, nothing is delivered): use the SMTP credentials of your Mailtrap inbox.
#   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StayReco <you@gmail.com>"

# 6-digit email verification code: lifetime and wrong guesses allowed before it is discarded
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Only used by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@stayreco.local
SEED_ADMIN_PASSWORD=Admin@123456

# Platform commission (%) for newly registered partners, allowed range 8-15
DEFAULT_COMMISSION_RATE=8

# Cloudinary (hotel images, verification documents). Dashboard → Settings → API Keys.
# Leave CLOUDINARY_CLOUD_NAME empty to disable uploads (upload endpoints answer 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AES-256-GCM key for beneficiary bank account numbers: 32 random bytes in base64. Required at startup.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once data exists (stored numbers would become unreadable). Same DB = same key.
BENEFICIARY_ENCRYPTION_KEY=

# Demo data for `npm run db:seed` (3 ACTIVE hotels, partners, staff, a platform manager, one pending verification).
# SEED_DEMO=false skips it. Demo accounts use SEED_DEMO_PASSWORD (default Demo@123456).
SEED_DEMO=true
SEED_DEMO_PASSWORD=Demo@123456
