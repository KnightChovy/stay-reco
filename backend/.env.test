NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://stayreco:stayreco@localhost:5432/stayreco_test?schema=public
CORS_ORIGINS=http://localhost:3001
WEB_APP_URL=http://localhost:3001
JWT_ACCESS_SECRET=test-secret-test-secret-test-secret-test-secret
VOUCHER_SIGNING_SECRET=voucher-test-secret-voucher-test-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Platform commission (%) for newly registered partners, allowed range 8-15
DEFAULT_COMMISSION_RATE=8

# Test-only key (not secret); real keys live in .env and must never be committed
BENEFICIARY_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# Payment simulator (POST /dev/bookings/:id/simulate-payment) for the e2e tests
PAYMENT_SIMULATOR=true

# SePay webhook API key used by the e2e tests (not secret)
SEPAY_WEBHOOK_API_KEY=sepay-test-key-sepay-test-key

# Platform bank account the e2e tests send transfers to. Set here so the real account in a local .env
# (loaded after this file for the variables it does not set) cannot make the webhook tests fail.
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_NAME=MB Bank
SEPAY_ACCOUNT_NUMBER=0000000000
SEPAY_ACCOUNT_NAME=STAYRECO DEMO
