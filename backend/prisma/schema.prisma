generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth / identity
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  HOTEL_PARTNER
  HOTEL_STAFF
  PLATFORM_MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INVITED // created by someone else, password not set yet
  SUSPENDED
  DELETED
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  ACCOUNT_INVITE
}

/// Login credentials shared by every actor. Business data lives in the 1-1 profile tables.
model Account {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique
  phone            String?       @unique
  passwordHash     String?       @map("password_hash")
  role             Role
  status           AccountStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?     @map("email_verified_at")
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until")
  lastLoginAt      DateTime?     @map("last_login_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  customer           Customer?
  hotelPartner       HotelPartner?
  hotelStaff         HotelStaff?
  platformManager    PlatformManager?
  admin              Admin?
  sessions           AuthSession[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]

  @@map("account")
}

/// One login on one device. Stays stable while its refresh tokens rotate.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([accountId])
  @@map("auth_session")
}

/// Every refresh token ever issued for a session. A used token presented again = token theft.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  accountId String                @map("account_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
  @@map("verification_token")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @map("account_id") @db.Uuid
  action    String
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([action, createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────
// Actor profiles (minimal — extend when building each module)
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("customer")
}

model HotelPartner {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @unique @map("account_id") @db.Uuid
  fullName    String   @map("full_name")
  companyName String?  @map("company_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  staff   HotelStaff[]

  @@map("hotel_partner")
}

/// TODO: add hotel_id FK once the HOTEL table exists.
model HotelStaff {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @unique @map("account_id") @db.Uuid
  hotelPartnerId String   @map("hotel_partner_id") @db.Uuid
  fullName       String   @map("full_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hotelPartner HotelPartner @relation(fields: [hotelPartnerId], references: [id], onDelete: Cascade)

  @@index([hotelPartnerId])
  @@map("hotel_staff")
}

model PlatformManager {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("platform_manager")
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("admin")
}
