model UserInteraction {
  userInteractionId String          @id @default(dbgenerated("gen_random_uuid()")) @map("user_interaction_id") @db.Uuid
  customerId        String?         @map("customer_id") @db.Uuid
  hotelId           String?         @map("hotel_id") @db.Uuid
  interactionType   InteractionType @map("interaction_type")
  durationSeconds   Int?            @map("duration_seconds")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer?       @relation(fields: [customerId], references: [customerId])
  hotel             Hotel?          @relation(fields: [hotelId], references: [hotelId])

  @@map("user_interaction")
}

model UserItemRating {
  userItemRatingId  String          @id @default(dbgenerated("gen_random_uuid()")) @map("user_item_rating_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  hotelId           String          @map("hotel_id") @db.Uuid
  ratingCriterionId String          @map("rating_criterion_id") @db.Uuid
  reviewId          String?         @map("review_id") @db.Uuid
  score             Decimal         @db.Decimal(3, 1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer        @relation(fields: [customerId], references: [customerId])
  hotel             Hotel           @relation(fields: [hotelId], references: [hotelId])
  ratingCriterion   RatingCriterion @relation(fields: [ratingCriterionId], references: [ratingCriterionId])
  review            Review?         @relation(fields: [reviewId], references: [reviewId])

  @@unique([customerId, hotelId, ratingCriterionId])
  @@map("user_item_rating")
}

model Voucher {
  voucherId     String       @id @default(dbgenerated("gen_random_uuid()")) @map("voucher_id") @db.Uuid
  promotionId   String       @map("promotion_id") @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  code          String       @unique @db.VarChar(50)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(14, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(14, 2)
  usedAt        DateTime?    @map("used_at") @db.Timestamptz(6)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  promotion     Promotion    @relation(fields: [promotionId], references: [promotionId])
  customer      Customer     @relation(fields: [customerId], references: [customerId])
  booking       Booking?

  @@map("voucher")
}

model Wallet {
  walletId           String              @id @default(dbgenerated("gen_random_uuid()")) @map("wallet_id") @db.Uuid
  /// Matches the owner column that is set (CHECK wallet_owner_shape); the platform wallet has neither.
  ownerType          WalletOwnerType     @map("owner_type")
  customerId         String?             @unique @map("customer_id") @db.Uuid
  hotelId            String?             @unique @map("hotel_id") @db.Uuid
  balanceAvailable   Decimal             @default(0) @map("balance_available") @db.Decimal(14, 2)
  balancePending     Decimal             @default(0) @map("balance_pending") @db.Decimal(14, 2)
  balanceReserved    Decimal             @default(0) @map("balance_reserved") @db.Decimal(14, 2)
  currency           String              @default("VND") @db.VarChar(10)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer?           @relation(fields: [customerId], references: [customerId])
  hotel              Hotel?              @relation(fields: [hotelId], references: [hotelId])
  walletTransactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  walletTransactionId String           @id @default(dbgenerated("gen_random_uuid()")) @map("wallet_transaction_id") @db.Uuid
  walletId            String           @map("wallet_id") @db.Uuid
  bookingId           String?          @map("booking_id") @db.Uuid
  platformManagerId   String?          @map("platform_manager_id") @db.Uuid
  type                WalletTxnType
  amount              Decimal          @db.Decimal(14, 2)
  balanceAfter        Decimal          @map("balance_after") @db.Decimal(14, 2)
  description         String?          @db.VarChar(500)
  idempotencyKey      String           @unique @map("idempotency_key") @db.VarChar(100)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet              Wallet           @relation(fields: [walletId], references: [walletId])
  booking             Booking?         @relation(fields: [bookingId], references: [bookingId])
  platformManager     PlatformManager? @relation(fields: [platformManagerId], references: [platformManagerId])

  @@map("wallet_transaction")
}
