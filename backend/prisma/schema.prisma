// StayReco — Prisma schema sinh từ trang "Physical" (stayReco_conceptual.drawio)
// Nullability của cột thường là suy đoán, cần rà lại trước khi migrate lần đầu.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, vector, unaccent]
}

enum UserRole {
  CUSTOMER
  HOTEL_STAFF
  HOTEL_PARTNER
  ADMIN
  PLATFORM_MANAGER

  @@map("user_role")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  INVITED
  SUSPENDED
  /// Turned off by the hotel partner (staff only); the partner can turn it back on. Not an admin suspension.
  DEACTIVATED
  DELETED

  @@map("account_status")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  ACCOUNT_INVITE

  @@map("verification_token_type")
}

enum StaffPermission {
  BOOKING
  FRONT_DESK
  CUSTOMER_CARE
  REFUND
  MARKETING

  @@map("staff_permission")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("partner_status")
}

enum HotelStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  INACTIVE

  @@map("hotel_status")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION

  @@map("verification_status")
}

enum VerificationRequestType {
  INITIAL
  UPDATE
  RENEWAL

  @@map("verification_request_type")
}

enum DocumentType {
  BUSINESS_LICENSE
  SECURITY_CERTIFICATE
  FIRE_SAFETY
  ID_CARD
  OTHER

  @@map("document_type")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE

  @@map("room_status")
}

enum CalendarStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED

  @@map("calendar_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  /// The 15-minute hold ran out before a matching payment; the rooms were released.
  EXPIRED

  @@map("booking_status")
}

enum PaymentMethod {
  VNPAY
  SEPAY
  WALLET
  CASH
  MIXED

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  /// The customer cancelled with money to refund; waiting for the partner to approve or reject.
  REFUND_PENDING

  @@map("payment_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN

  @@map("day_of_week")
}

/// BASE is the room type's base price; the others adjust it for some nights or booking dates (docs/money-rules.md §2).
enum PriceRuleType {
  BASE
  SEASON
  EARLY_BIRD
  LAST_MINUTE

  @@map("price_rule_type")
}

enum PriceAdjustmentType {
  SET_PRICE
  AMOUNT
  PERCENT

  @@map("price_adjustment_type")
}

enum LoyaltyTier {
  MEMBER
  SILVER
  GOLD
  PLATINUM

  @@map("loyalty_tier")
}

/// PLATFORM is StayReco's own wallet (commission, platform-side adjustments); there is exactly one.
enum WalletOwnerType {
  CUSTOMER
  HOTEL
  PLATFORM

  @@map("wallet_owner_type")
}

enum WalletTxnType {
  BOOKING_PAYMENT
  COMMISSION
  PAYOUT
  REFUND
  TOPUP
  ADJUSTMENT

  @@map("wallet_txn_type")
}

enum ConversationChannel {
  WEB
  MOBILE

  @@map("conversation_channel")
}

enum ConversationStatus {
  OPEN
  ESCALATED
  CLOSED

  @@map("conversation_status")
}

enum MessageRole {
  USER
  ASSISTANT
  STAFF
  SYSTEM

  @@map("message_role")
}

enum NotificationType {
  BOOKING
  PAYMENT
  PROMOTION
  REVIEW
  ALERT
  SYSTEM

  @@map("notification_type")
}

enum InteractionType {
  VIEW
  SEARCH
  CLICK
  WISHLIST
  BOOK

  @@map("interaction_type")
}

enum ContentType {
  POST
  BLOG
  CAPTION
  PROMOTION

  @@map("content_type")
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED

  @@map("content_status")
}

enum ScheduleStatus {
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED

  @@map("schedule_status")
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK

  @@map("social_platform")
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("violation_severity")
}

enum ViolationStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED

  @@map("violation_status")
}

enum ModelRunStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("model_run_status")
}

model Admin {
  adminId     String      @id @map("admin_id") @db.Uuid
  userAccount UserAccount @relation(fields: [adminId], references: [userAccountId], onDelete: Cascade)
  auditLogs   AuditLog[]
  aiConfigs   AiConfig[]

  @@map("admin")
}

model AiConfig {
  aiConfigId     String        @id @default(dbgenerated("gen_random_uuid()")) @map("ai_config_id") @db.Uuid
  adminId        String?       @map("admin_id") @db.Uuid
  hotelPartnerId String?       @map("hotel_partner_id") @db.Uuid
  configKey      String        @map("config_key") @db.VarChar(100)
  configValue    String        @map("config_value")
  description    String?       @db.VarChar(500)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  admin          Admin?        @relation(fields: [adminId], references: [adminId])
  hotelPartner   HotelPartner? @relation(fields: [hotelPartnerId], references: [hotelPartnerId])

  @@map("ai_config")
}

model AiFunctionCall {
  aiFunctionCallId String   @id @default(dbgenerated("gen_random_uuid()")) @map("ai_function_call_id") @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  bookingId        String?  @map("booking_id") @db.Uuid
  functionName     String   @map("function_name") @db.VarChar(100)
  arguments        Json?    @db.JsonB
  result           Json?    @db.JsonB
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message          Message  @relation(fields: [messageId], references: [messageId])
  booking          Booking? @relation(fields: [bookingId], references: [bookingId])

  @@map("ai_function_call")
}

model Amenity {
  amenityId         String            @id @default(dbgenerated("gen_random_uuid()")) @map("amenity_id") @db.Uuid
  name              String            @db.VarChar(100)
  icon              String?           @db.VarChar(100)
  category          String            @db.VarChar(50)
  hotelAmenities    HotelAmenity[]
  roomTypeAmenities RoomTypeAmenity[]

  @@map("amenity")
}

model AuditLog {
  auditLogId        String           @id @default(dbgenerated("gen_random_uuid()")) @map("audit_log_id") @db.Uuid
  customerId        String?          @map("customer_id") @db.Uuid
  hotelStaffId      String?          @map("hotel_staff_id") @db.Uuid
  hotelPartnerId    String?          @map("hotel_partner_id") @db.Uuid
  adminId           String?          @map("admin_id") @db.Uuid
  platformManagerId String?          @map("platform_manager_id") @db.Uuid
  action            String           @db.VarChar(100)
  entityType        String?          @map("entity_type") @db.VarChar(100)
  entityId          String?          @map("entity_id") @db.Uuid
  oldValue          String?          @map("old_value")
  newValue          String?          @map("new_value")
  ipAddress         String?          @map("ip_address") @db.VarChar(45)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer?        @relation(fields: [customerId], references: [customerId])
  hotelStaff        HotelStaff?      @relation(fields: [hotelStaffId], references: [hotelStaffId])
  hotelPartner      HotelPartner?    @relation(fields: [hotelPartnerId], references: [hotelPartnerId])
  admin             Admin?           @relation(fields: [adminId], references: [adminId])
  platformManager   PlatformManager? @relation(fields: [platformManagerId], references: [platformManagerId])

  @@map("audit_log")
}

model BedType {
  bedTypeId    String        @id @default(dbgenerated("gen_random_uuid()")) @map("bed_type_id") @db.Uuid
  name         String        @db.VarChar(50)
  description  String?       @db.VarChar(200)
  capacity     Int?
  roomTypeBeds RoomTypeBed[]

  @@map("bed_type")
}

model Booking {
  bookingId          String              @id @default(dbgenerated("gen_random_uuid()")) @map("booking_id") @db.Uuid
  customerId         String              @map("customer_id") @db.Uuid
  roomTypeId         String              @map("room_type_id") @db.Uuid
  hotelStaffId       String?             @map("hotel_staff_id") @db.Uuid
  voucherId          String?             @unique @map("voucher_id") @db.Uuid
  promotionId        String?             @map("promotion_id") @db.Uuid
  loyaltyProgramId   String?             @map("loyalty_program_id") @db.Uuid
  recommendationId   String?             @map("recommendation_id") @db.Uuid
  checkInDate        DateTime            @map("check_in_date") @db.Date
  checkOutDate       DateTime            @map("check_out_date") @db.Date
  numGuests          Int?                @map("num_guests")
  /// Rooms of the one room type held or booked; kept after the nights are released.
  numRooms           Int                 @map("num_rooms")
  /// [{ date, price }] per room, fixed at booking time (BR-09); kept after the nights are released.
  nightlyPrices      Json                @map("nightly_prices")
  totalAmount        Decimal             @map("total_amount") @db.Decimal(14, 2)
  currency           String              @default("VND") @db.VarChar(10)
  status             BookingStatus       @default(PENDING)
  specialRequests    String?             @map("special_requests")
  guestName          String              @map("guest_name") @db.VarChar(100)
  contactPhone       String              @map("contact_phone") @db.VarChar(20)
  /// Start of the one-hour arrival window chosen by the customer.
  arrivalTime        DateTime?           @map("arrival_time") @db.Time(0)
  /// Fixed at booking time (BR-07); null means no free-cancellation period.
  freeCancelUntil    DateTime?           @map("free_cancel_until") @db.Timestamptz(6)
  cancelFeePercent   Decimal             @map("cancel_fee_percent") @db.Decimal(5, 2)
  /// Partner commission rate at booking time (BR-13).
  commissionRate     Decimal             @map("commission_rate") @db.Decimal(5, 2)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer            @relation(fields: [customerId], references: [customerId])
  // Kept even after room_calendars rows are released (cancel / no-show), so the booking never loses its hotel.
  roomType           RoomType            @relation(fields: [roomTypeId], references: [roomTypeId])
  hotelStaff         HotelStaff?         @relation(fields: [hotelStaffId], references: [hotelStaffId])
  voucher            Voucher?            @relation(fields: [voucherId], references: [voucherId])
  promotion          Promotion?          @relation(fields: [promotionId], references: [promotionId])
  loyaltyProgram     LoyaltyProgram?     @relation(fields: [loyaltyProgramId], references: [loyaltyProgramId])
  recommendation     Recommendation?     @relation(fields: [recommendationId], references: [recommendationId])
  roomCalendars      RoomCalendars[]
  invoice            Invoice?
  walletTransactions WalletTransaction[]
  review             Review?
  conversations      Conversation[]
  aiFunctionCalls    AiFunctionCall[]

  @@map("booking")
}

model ContentEmbedding {
  contentEmbeddingId String                      @id @default(dbgenerated("gen_random_uuid()")) @map("content_embedding_id") @db.Uuid
  knowledgeArticleId String?                     @map("knowledge_article_id") @db.Uuid
  chunkIndex         Int?                        @map("chunk_index")
  chunkText          String                      @map("chunk_text")
  embedding          Unsupported("vector(768)")?
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  knowledgeArticle   KnowledgeArticle?           @relation(fields: [knowledgeArticleId], references: [knowledgeArticleId])

  @@map("content_embedding")
}

model ContentMetric {
  contentMetricId   String          @id @default(dbgenerated("gen_random_uuid()")) @map("content_metric_id") @db.Uuid
  contentScheduleId String          @map("content_schedule_id") @db.Uuid
  platform          SocialPlatform
  views             Int
  likes             Int
  shares            Int
  comments          Int
  recordedAt        DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  contentSchedule   ContentSchedule @relation(fields: [contentScheduleId], references: [contentScheduleId])

  @@map("content_metric")
}

model ContentSchedule {
  contentScheduleId  String           @id @default(dbgenerated("gen_random_uuid()")) @map("content_schedule_id") @db.Uuid
  marketingContentId String           @map("marketing_content_id") @db.Uuid
  socialAccountId    String           @map("social_account_id") @db.Uuid
  scheduledAt        DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(6)
  status             ScheduleStatus   @default(SCHEDULED)
  marketingContent   MarketingContent @relation(fields: [marketingContentId], references: [marketingContentId])
  socialAccount      SocialAccount    @relation(fields: [socialAccountId], references: [socialAccountId])
  contentMetrics     ContentMetric[]

  @@map("content_schedule")
}

model Conversation {
  conversationId String              @id @default(dbgenerated("gen_random_uuid()")) @map("conversation_id") @db.Uuid
  customerId     String?             @map("customer_id") @db.Uuid
  hotelStaffId   String?             @map("hotel_staff_id") @db.Uuid
  bookingId      String?             @map("booking_id") @db.Uuid
  hotelId        String?             @map("hotel_id") @db.Uuid
  channel        ConversationChannel
  status         ConversationStatus  @default(OPEN)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer       Customer?           @relation(fields: [customerId], references: [customerId])
  hotelStaff     HotelStaff?         @relation(fields: [hotelStaffId], references: [hotelStaffId])
  booking        Booking?            @relation(fields: [bookingId], references: [bookingId])
  hotel          Hotel?              @relation(fields: [hotelId], references: [hotelId])
  messages       Message[]

  @@map("conversation")
}

model Customer {
  customerId          String               @id @map("customer_id") @db.Uuid
  dateOfBirth         DateTime?            @map("date_of_birth") @db.Date
  gender              Gender?
  nationality         String?              @db.VarChar(100)
  userAccount         UserAccount          @relation(fields: [customerId], references: [userAccountId], onDelete: Cascade)
  auditLogs           AuditLog[]
  customerPreferences CustomerPreference[]
  bookings            Booking[]
  vouchers            Voucher[]
  wallet              Wallet?
  loyaltyAccounts     LoyaltyAccount[]
  reviews             Review[]
  userItemRatings     UserItemRating[]
  userInteractions    UserInteraction[]
  ratingPredictions   RatingPrediction[]
  recommendations     Recommendation[]
  conversations       Conversation[]

  @@map("customer")
}

model CustomerPreference {
  customerPreferenceId String   @id @default(dbgenerated("gen_random_uuid()")) @map("customer_preference_id") @db.Uuid
  customerId           String   @map("customer_id") @db.Uuid
  preferenceKey        String   @map("preference_key") @db.VarChar(100)
  preferenceValue      String   @map("preference_value")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer             Customer @relation(fields: [customerId], references: [customerId])

  @@map("customer_preference")
}

model Hotel {
  hotelId              String                     @id @default(dbgenerated("gen_random_uuid()")) @map("hotel_id") @db.Uuid
  hotelPartnerId       String                     @map("hotel_partner_id") @db.Uuid
  name                 String                     @db.VarChar(255)
  description          String?
  address              String                     @db.VarChar(500)
  city                 String                     @db.VarChar(100)
  country              String                     @db.VarChar(100)
  latitude             Decimal?                   @db.Decimal(10, 7)
  longitude            Decimal?                   @db.Decimal(10, 7)
  starRating           Int?                       @map("star_rating")
  phone                String?                    @db.VarChar(20)
  email                String                     @db.VarChar(255)
  website              String?                    @db.VarChar(500)
  checkInTime          DateTime?                  @map("check_in_time") @db.Time(6)
  checkOutTime         DateTime?                  @map("check_out_time") @db.Time(6)
  status               HotelStatus                @default(DRAFT)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  hotelPartner         HotelPartner               @relation(fields: [hotelPartnerId], references: [hotelPartnerId])
  hotelProperties      HotelProperties[]
  hotelRoomConfig      HotelRoomConfig?
  hotelStaffs          HotelStaff[]
  roomTypes            RoomType[]
  hotelAmenities       HotelAmenity[]
  promotions           Promotion[]
  wallet               Wallet?
  loyaltyPrograms      LoyaltyProgram[]
  reviews              Review[]
  userItemRatings      UserItemRating[]
  userInteractions     UserInteraction[]
  ratingPredictions    RatingPrediction[]
  recommendations      Recommendation[]
  socialAccounts       SocialAccount[]
  marketingContents    MarketingContent[]
  conversations        Conversation[]
  knowledgeArticles    KnowledgeArticle[]
  verificationRequests HotelVerificationRequest[]
  hotelImages          HotelImage[]

  @@map("hotel")
}

/// Photos of a hotel; at most one is the cover shown in search results.
model HotelImage {
  hotelImageId String   @id @default(dbgenerated("gen_random_uuid()")) @map("hotel_image_id") @db.Uuid
  hotelId      String   @map("hotel_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(500)
  /// Cloudinary public id, used to delete the file.
  storageKey   String   @map("storage_key") @db.VarChar(255)
  caption      String?  @db.VarChar(255)
  isCover      Boolean  @default(false) @map("is_cover")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  hotel        Hotel    @relation(fields: [hotelId], references: [hotelId], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_image")
}

model HotelAmenity {
  hotelAmenityId String  @id @default(dbgenerated("gen_random_uuid()")) @map("hotel_amenity_id") @db.Uuid
  hotelId        String  @map("hotel_id") @db.Uuid
  amenityId      String  @map("amenity_id") @db.Uuid
  hotel          Hotel   @relation(fields: [hotelId], references: [hotelId])
  amenity        Amenity @relation(fields: [amenityId], references: [amenityId])

  @@unique([hotelId, amenityId])
  @@map("hotel_amenity")
}

model HotelPartner {
  hotelPartnerId   String            @id @map("hotel_partner_id") @db.Uuid
  partnerName      String            @map("partner_name") @db.VarChar(255)
  contactEmail     String            @map("contact_email") @db.VarChar(255)
  contactPhone     String            @map("contact_phone") @db.VarChar(20)
  businessLicense  String?           @map("business_license") @db.VarChar(100)
  commissionRate   Decimal           @map("commission_rate") @db.Decimal(5, 2)
  status           PartnerStatus     @default(PENDING)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  userAccount      UserAccount       @relation(fields: [hotelPartnerId], references: [userAccountId], onDelete: Cascade)
  auditLogs        AuditLog[]
  aiConfigs        AiConfig[]
  hotels           Hotel[]
  policyViolations PolicyViolation[]

  @@map("hotel_partner")
}

model HotelProperties {
  hotelPropertyId        String                     @id @default(dbgenerated("gen_random_uuid()")) @map("hotel_property_id") @db.Uuid
  hotelId                String                     @map("hotel_id") @db.Uuid
  verificationRequestId  String?                    @map("verification_request_id") @db.Uuid
  verificationDocumentId String?                    @map("verification_document_id") @db.Uuid
  propertyKey            String                     @map("property_key") @db.VarChar(100)
  propertyValue          String                     @map("property_value")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  hotel                  Hotel                      @relation(fields: [hotelId], references: [hotelId])
  verificationRequest    HotelVerificationRequest?  @relation(fields: [verificationRequestId], references: [verificationRequestId])
  verificationDocument   HotelVerificationDocument? @relation(fields: [verificationDocumentId], references: [verificationDocumentId])

  @@map("hotel_properties")
}

model HotelRoomConfig {
  hotelRoomConfigId String   @id @default(dbgenerated("gen_random_uuid()")) @map("hotel_room_config_id") @db.Uuid
  /// One configuration per hotel (contract D4).
  hotelId           String   @unique @map("hotel_id") @db.Uuid
  totalRooms        Int      @map("total_rooms")
  basePrice         Decimal  @map("base_price") @db.Decimal(14, 2)
  currency          String   @default("VND") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  hotel             Hotel    @relation(fields: [hotelId], references: [hotelId])

  @@map("hotel_room_config")
}

model HotelStaff {
  hotelStaffId      String             @id @map("hotel_staff_id") @db.Uuid
  hotelId           String             @map("hotel_id") @db.Uuid
  position          String             @db.VarChar(50)
  /// Permission groups granted by the hotel partner (SRS UC62).
  permissions       StaffPermission[]  @default([])
  userAccount       UserAccount        @relation(fields: [hotelStaffId], references: [userAccountId], onDelete: Cascade)
  hotel             Hotel              @relation(fields: [hotelId], references: [hotelId])
  auditLogs         AuditLog[]
  bookings          Booking[]
  marketingContents MarketingContent[]
  conversations     Conversation[]

  @@map("hotel_staff")
}

model HotelVerificationDocument {
  verificationDocumentId String                      @id @default(dbgenerated("gen_random_uuid()")) @map("verification_document_id") @db.Uuid
  verificationRequestId  String                      @map("verification_request_id") @db.Uuid
  parentDocumentId       String?                     @map("parent_document_id") @db.Uuid
  documentType           DocumentType                @map("document_type")
  fileUrl                String                      @map("file_url") @db.VarChar(500)
  uploadedAt             DateTime                    @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  verificationRequest    HotelVerificationRequest    @relation(fields: [verificationRequestId], references: [verificationRequestId])
  parentDocument         HotelVerificationDocument?  @relation("DocumentHierarchy", fields: [parentDocumentId], references: [verificationDocumentId])
  hotelProperties        HotelProperties[]
  childDocuments         HotelVerificationDocument[] @relation("DocumentHierarchy")

  @@map("hotel_verification_document")
}

model HotelVerificationRequest {
  verificationRequestId      String                      @id @default(dbgenerated("gen_random_uuid()")) @map("verification_request_id") @db.Uuid
  hotelId                    String                      @map("hotel_id") @db.Uuid
